    },
    "submitter_id": {
     "type": "string"
    }
   }
  },
  "to_one": {
   "anyOf": [
    {
     "type": "array",
     "items": {
      "$ref": "#/foreign_key",
      "minItems": 1,
      "maxItems": 1
     }
    },
    {
     "$ref": "#/foreign_key"
    }
   ]
  },
  "ubiquitous_properties": {
